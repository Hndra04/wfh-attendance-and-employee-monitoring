{
  "name": "@wfh-attendance/absensi-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "vitest run --root src",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/migration-data-source.ts",
    "db:migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/migration-data-source.ts",
    "db:migration:generate": "typeorm-ts-node-commonjs migration:generate",
    "seed:demo": "npm run db:migrate && node scripts/seed-demo.mjs",
    "seed:performance": "npm run db:migrate && node scripts/seed-performance.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "mysql2": "^3.11.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.6.2",
    "typeorm": "^0.3.31",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  }
}
