{
  "name": "wfh-attendance-and-employee-monitoring",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "typeorm": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    }
  },
  "scripts": {
    "dev:absensi-service": "npm run start:dev -w @wfh-attendance/absensi-service",
    "dev:monitoring-service": "npm run start:dev -w @wfh-attendance/monitoring-service",
    "dev:absensi-web": "npm run dev -w @wfh-attendance/absensi-web",
    "dev:monitoring-web": "npm run dev -w @wfh-attendance/monitoring-web",
    "build": "npm run build --workspaces --if-present",
    "docker:up": "docker compose up -d mysql",
    "docker:down": "docker compose down"
  }
}
